# Existing non-root Pi user that runs Cog. Change this to your username.
KIOSK_USER=pi
HA_URL=http://homeassistant.local:8123
SCREEN_TIMEOUT=10
BRIGHTNESS_PERCENT=75
FADE_DURATION=1.5
TOUCH_DEVICE=/dev/input/by-path/platform-3f205000.i2c-event
# Optional absolute sysfs directory; empty selects the sole detected backlight.
BACKLIGHT_DEVICE=
